; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ReSun"
run/main_scene="uid://c6s5n02jefgmd"
config/features=PackedStringArray("26.2", "Forward Plus", "Redot")
config/icon="res://icon.svg"

[autoload]

GameContext="*res://scripts/core/GameContext.gd" ; Must resolve the active game before EntityFactory/TerrainCatalog/AudioManager register data
FactionCatalog="*res://scripts/core/FactionCatalog.gd" ; Must load the active game's factions before PlayerManager reads the default roster
CampaignCatalog="*res://scripts/core/CampaignCatalog.gd"
PlayerManager="*res://scripts/core/PlayerManager.gd"
VeterancySystem="*res://scripts/core/VeterancySystem.gd"
InputSettings="*res://scripts/core/InputSettings.gd"
SelectionManager="*res://scripts/core/SelectionManager.gd"
OrderSystem="*res://scripts/core/OrderSystem.gd"
DebugVisualizer="*res://scripts/core/DebugVisualizer.gd"
MoveLineRenderer="*res://scripts/core/MoveLineRenderer.gd"
SpatialHashSingleton="*res://scripts/core/SpatialHash.gd"
CellReservationSingleton="*res://scripts/core/CellReservation.gd"
TerrainSystem="*res://scripts/core/TerrainSystem.gd"
TerrainCatalog="*res://scripts/core/TerrainCatalog.gd"
EntityFactory="*res://scripts/entities/EntityFactory.gd"
BatchLoader="*res://scripts/core/BatchLoader.gd"
EntityPlacer="*res://scripts/entities/EntityPlacer.gd"
BuildingManager="*res://scripts/buildings/BuildingManager.gd"
EconomyManager="*res://scripts/economy/EconomyManager.gd"
ResourceGrowthSystem="*res://scripts/core/ResourceGrowthSystem.gd"
SelectionOverlay="*res://scripts/ui/SelectionOverlay.gd"
PowerGrid="*res://scripts/core/PowerGrid.gd" ; ProductionManager connects in _ready — must be ready before it
RadarSystem="*res://scripts/core/RadarSystem.gd" ; Consumers (Minimap) connect in _ready — must be ready before UI scenes
PrerequisiteSystem="*res://scripts/production/PrerequisiteSystem.gd"
ProductionManager="*res://scripts/production/ProductionManager.gd"
BoundsSystem="*res://scripts/core/BoundsSystem.gd"
UnitMeshRenderer="*res://scripts/core/UnitMeshRenderer.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
ShroudSystem="*res://scripts/core/ShroudSystem.gd"
FogRenderer="*res://scripts/core/FogRenderer.gd"
FxSystem="*res://scripts/core/FxSystem.gd" ; Connects to ShroudSystem.state_changed in _ready — keep after ShroudSystem
MatchClock="*res://scripts/core/MatchClock.gd" ; Fixed 30 Hz logic clock + deadline scheduler; no dependencies
ScenarioState="*res://scripts/core/ScenarioState.gd" ; Mission flags/waypoints/timer; binds to MatchClock in _ready — keep after MatchClock
TriggerEngine="*res://scripts/triggers/TriggerEngine.gd" ; Mission trigger runtime; binds to MatchClock + ScenarioState in _ready — keep after both

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[gdscript]

warnings/integer_division=0

[rendering]

lights_and_shadows/directional_shadow/size=4096

